<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifest of the :Spacecore wrapper module.

    Deliberately minimal. Everything the engine needs is declared by the AAR's
    own manifest (flib-release.aar), which the manifest merger pulls in through
    the `com.fvbox:flib:1.0.0` dependency: the ~2500 proxy activities, the
    :sc0..:scN process pool, the sandbox services/providers and the engine's
    permission list.

    In particular there is NO <application android:name="..."> here or in the
    AAR: the loader keeps its own com.zyn.bs.BoxApplication, which is what calls
    FCore.get().init(...) in attachBaseContext. Never point this at the
    engine's demo Application class (com.fvbox.BoxApplication) — it lives in the
    demo app, not in the AAR.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" />
