<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".BoxApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/LoaderTheme"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:debuggable="${debuggable}">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/LoaderTheme"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The engine's components (the sandbox services/providers, the guest
            process pool, the proxy activities, the file provider, ...) are
            merged in from app/libs/elite.aar. Do not declare them here.
        -->
        <!--
            android:debuggable is pinned above through ${debuggable} because a
            library manifest may hardcode android:debuggable="true"; the
            placeholder keeps release builds non-debuggable.
        -->
    </application>

</manifest>
